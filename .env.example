# Cấu hình Database
# Môi trường Development (SQLite local)
DATABASE_URL=sqlite:///./kpi_codien.db

# Môi trường Production aaPanel (MySQL / MariaDB):
# Định dạng: mysql+pymysql://<user>:<password>@127.0.0.1:3306/<database_name>?charset=utf8mb4
# Ví dụ:
# DATABASE_URL=mysql+pymysql://kpi_user:MatKhauManh123@127.0.0.1:3306/kpi_codien?charset=utf8mb4

# Kích thước chunk xử lý bulk upsert (5000 - 10000 dòng/batch)
CHUNK_SIZE=5000

# Chế độ Debug
DEBUG=False
